* limitations under the License.
*******************************************************************************/

/*###ICF### Section handled by ICF editor, don't touch! ****/
/*-Editor annotation file-*/
/* IcfEditorFile="$TOOLKIT_DIR$\config\ide\IcfEditor\cortex_v1_4.xml" */
/*-Specials-*/

define symbol __ICFEDIT_region_RAM_CODE_start__   = 0x00000000;
define symbol __ICFEDIT_region_RAM_CODE_size__    = 0x00014000; /* 80K - increased for larger code across M0, M2, M3 regions */
define symbol __ICFEDIT_region_RAM_DATA_start__   = 0x20000000;
define symbol __ICFEDIT_region_RAM_DATA_size__    = 0x00004000; /* 16K - M1/M3 Data memory size */
define symbol __ICFEDIT_region_RAM_SHARED_start__ = 0x20040000;
define symbol __ICFEDIT_region_RAM_SHARED_size__  = 0x00004000; /* 16K - M4 shared memory size */

if (!isdefinedsymbol(__STACK_SIZE)) {
  define symbol __ICFEDIT_size_cstack__ = 0x800;
} else {
  define symbol __ICFEDIT_size_cstack__ = __STACK_SIZE;
}
define symbol __ICFEDIT_size_proc_stack__ = 0x0;

/* Defines the minimum heap size. The actual heap size will be expanded to the end of the stack region */
if (!isdefinedsymbol(__HEAP_SIZE)) {
    define symbol __ICFEDIT_size_heap__ = 0x0400;
} else {
  define symbol __ICFEDIT_size_heap__ = __HEAP_SIZE;
}

define memory mem with size = 4G;
define region CODE_region = mem:[from __ICFEDIT_region_RAM_CODE_start__ size __ICFEDIT_region_RAM_CODE_size__];
define region DATA_region = mem:[from __ICFEDIT_region_RAM_DATA_start__ size __ICFEDIT_region_RAM_DATA_size__];
define region shared_mem_region =  mem:[from __ICFEDIT_region_RAM_SHARED_start__ size __ICFEDIT_region_RAM_SHARED_size__]; /* shared_ram0 */

define block CSTACK     with alignment = 8, size = __ICFEDIT_size_cstack__     { };
define block PROC_STACK with alignment = 8, size = __ICFEDIT_size_proc_stack__ { };
define block HEAP       with expanding size, alignment = 8, minimum size = __ICFEDIT_size_heap__ { };
define block HSTACK {block HEAP, block PROC_STACK, last block CSTACK};
define block RO     {first section .intvec, readonly};

/*-Initializations-*/
initialize by copy { readwrite };
do not initialize  { section .noinit, section .intvec_ram };

/*-Placement-*/

/* Flash - Cortex-M33 application */
place at address (__ICFEDIT_region_RAM_CODE_start__) { block RO };

/* RAM */
place at start of DATA_region  { readwrite section .intvec_ram};
place in          DATA_region  { readwrite };
place at end   of DATA_region  { block HSTACK };

place in          shared_mem_region { readwrite section .cy_sharedmem };

keep {  section .intvec  };

/* EOF */
